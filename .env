
INPUT_DIR  = "/home/djorgs/Documents/Obsidian/David Second Brain/inbox/"
OUTPUT_DIR = "/home/djorgs/Documents/Obsidian/David Second Brain/bin/inbox-processed/"
NUMBER_TO_FETCH = 5 # How many of the most recent .md files to process. If you want all files processed every time the script runs, enter "0".
DELETE_OLD_URLS = false # set to true if you want processed inbox URLs to be deleted

OLLAMA_API_KEY = "" # Only needed if using cloud hosted model
MODEL      = "gemma4:e4b"

# If using locally hosted model, use first option. If using cloud hosted model, use second option.
OLLAMA_CMD = ["ollama", "run", MODEL]  # local model
# OLLAMA_CMD = ["ollama", "serve", OLLAMA_API_KEY] # streaming model

# Domains of websites that block headless browsers from scraping content (Selenium will always be used as a fallback if the default urllib scraping method fails)
SELENIUM_DOMAINS = {
    "reddit.com", "www.reddit.com",
    "old.reddit.com",
    "twitter.com", "www.twitter.com",
    "x.com", "www.x.com",
    "instagram.com", "www.instagram.com",
    "facebook.com", "www.facebook.com",
    "tiktok.com", "www.tiktok.com",
    "linkedin.com", "www.linkedin.com",
}
